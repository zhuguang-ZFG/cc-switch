{
  "schema": 1,
  "projects": [
    {
      "root": "@repository",
      "repairOnFailure": true,
      "protectedPaths": [
        "scripts/ops/bugfix-cases.mjs",
        "scripts/ops/compare_omp_bugfix.mjs",
        "scripts/ops/task-verification-policy.json",
        "scripts/ops/task-verification-hutuji.json",
        "scripts/ops/review/"
      ],
      "checks": [
        {
          "id": "omp-extensions",
          "paths": [
            "scripts/ops/omp-task-verification.js",
            "scripts/ops/task-verification-policy.json",
            "scripts/ops/test_omp_task_verification.js",
            "scripts/ops/bugfix-cases.mjs",
            "scripts/ops/compare_omp_bugfix.mjs",
            "scripts/ops/test_omp_bugfix_cases.js",
            "scripts/ops/omp-problem-solving.js",
            "scripts/ops/omp-sota-escalation.js",
            "scripts/ops/omp-model-routing-observability.js",
            "scripts/ops/omp-unexpected-stop-guard.js",
            "scripts/ops/review/",
            "scripts/ops/test_omp_problem_solving.js",
            "scripts/ops/test_omp_sota_escalation.js",
            "scripts/ops/test_omp_model_routing_observability.js",
            "scripts/ops/test_omp_unexpected_stop_guard.js"
          ],
          "command": "@node",
          "args": [
            "--test",
            "--test-reporter=tap",
            "scripts/ops/test_omp_task_verification.js",
            "scripts/ops/test_omp_bugfix_cases.js",
            "scripts/ops/test_omp_problem_solving.js",
            "scripts/ops/test_omp_sota_escalation.js",
            "scripts/ops/test_omp_model_routing_observability.js",
            "scripts/ops/test_omp_unexpected_stop_guard.js"
          ],
          "evidence": "node-test",
          "timeoutMs": 60000
        },
        {
          "id": "omp-verification-deployment",
          "paths": [
            "scripts/ops/deploy-omp-verification.py",
            "scripts/ops/test_deploy_omp_verification.py"
          ],
          "command": "@python",
          "args": [
            "-m",
            "unittest",
            "discover",
            "-s",
            "scripts/ops",
            "-p",
            "test_deploy_omp_verification.py"
          ],
          "evidence": "unittest",
          "timeoutMs": 60000
        },
        {
          "id": "omp-native-verification",
          "paths": ["scripts/ops/probe_omp_verification.py"],
          "command": "@python",
          "args": ["scripts/ops/probe_omp_verification.py"],
          "evidence": "exit-code",
          "timeoutMs": 90000
        },
        {
          "id": "omp-solving-upgrade",
          "paths": [
            "scripts/ops/deploy-omp-solving-upgrade.py",
            "scripts/ops/test_deploy_omp_solving_upgrade.py",
            "scripts/ops/task-verification-hutuji.json"
          ],
          "command": "@python",
          "args": [
            "-m",
            "unittest",
            "discover",
            "-s",
            "scripts/ops",
            "-p",
            "test_deploy_omp_solving_upgrade.py"
          ],
          "evidence": "unittest",
          "timeoutMs": 15000
        },
        {
          "id": "omp-bugfix-benchmark",
          "paths": ["scripts/ops/bench_omp_bugfix.mjs"],
          "command": "@node",
          "args": ["scripts/ops/bench_omp_bugfix.mjs"],
          "evidence": "exit-code",
          "timeoutMs": 60000
        },
        {
          "id": "renderer-types",
          "paths": [
            "src/",
            "tests/",
            "tsconfig.json",
            "tsconfig.node.json",
            "package.json",
            "pnpm-lock.yaml",
            "vite.config.ts",
            "vitest.config.ts"
          ],
          "command": "@node",
          "args": ["node_modules/typescript/bin/tsc", "--noEmit"],
          "evidence": "exit-code",
          "timeoutMs": 60000
        },
        {
          "id": "renderer-tests",
          "paths": [
            "src/",
            "tests/",
            "vitest.config.ts",
            "vite.config.ts",
            "tsconfig.json",
            "tsconfig.node.json",
            "package.json",
            "pnpm-lock.yaml"
          ],
          "command": "@node",
          "args": [
            "node_modules/vitest/vitest.mjs",
            "run",
            "--reporter=default"
          ],
          "evidence": "vitest",
          "timeoutMs": 90000
        }
      ]
    }
  ]
}
